{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "ES2020",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "paths": {
      "@larpbabylone/user-module": ["../../../services/shared/user-module/dist"]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
