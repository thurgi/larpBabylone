ARG NODE_IMAGE=node:20-alpine
FROM ${NODE_IMAGE}

WORKDIR /workspace/services

COPY services/shared/user-module /workspace/services/shared/user-module
COPY services/shared/nest-user-module /workspace/services/shared/nest-user-module
COPY services/objects /workspace/services/objects

WORKDIR /workspace/services/objects
RUN npm ci --omit=dev

ENV DATA_DIR=/data

VOLUME ["/data"]

EXPOSE 3001

CMD ["node", "dist/main.js"]
