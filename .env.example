# -- quay. io infromation login and token for docker-compose build
QUAY_LOGIN=
QUAY_TOKEN=

# ── Ports ────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3001

# ── Keycloak (backends) ───────────────────────────────────────────────────
KEYCLOAK_BASE_URL=http://localhost:15010
KEYCLOAK_REALM=master
KEYCLOAK_CLIENT_ID=larpbabylone
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_INTROSPECTION_TTL_SECONDS=30

# ── Shell Angular (front/shell) ───────────────────────────────────────────
SHELL_KEYCLOAK_BASE_URL=http://localhost:15010
SHELL_KEYCLOAK_REALM=master
SHELL_KEYCLOAK_CLIENT_ID=larpbabylone
SHELL_REDIRECT_URI=http://localhost:3000
SHELL_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# ── Super-admin (username qui bypass toutes les permissions) ─────────────
ADMIN_USERNAME=admin

# Pattern CORS autorisé (regex) — adapte en prod
CORS_ORIGIN_PATTERN=.*\.localhost(:\d+)?$

# ── Redirection après login ───────────────────────────────────────────────
DEFAULT_REDIRECT_URL=http://localhost:3000
