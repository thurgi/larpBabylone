# ── Ports ────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000
AUTH_PORT=3002

# ── URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001
VITE_AUTH_SERVICE_URL=http://auth.localhost:3000
AUTH_SERVICE_URL=http://auth.localhost:3000

# ── Sécurité (partagé entre auth-service et backends) ────────────────────
JWT_SECRET=change-me-with-a-strong-secret

# ── Super-admin (username qui bypass toutes les permissions) ─────────────
ADMIN_USERNAME=admin

# ── Cookie cross-subdomain ────────────────────────────────────────────────
# En dev : localhost | En prod : .mondomaine.fr
COOKIE_DOMAIN=localhost
# Pattern CORS autorisé (regex) — adapte en prod
CORS_ORIGIN_PATTERN=.*\.localhost(:\d+)?$

# ── Discord OAuth2 ───────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://auth.localhost:3000/auth/discord/callback

# ── Google OAuth2 ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://auth.localhost:3000/auth/google/callback

# ── Redirection après login ───────────────────────────────────────────────
DEFAULT_REDIRECT_URL=http://localhost:3000
