{
  "name": "larpbabylone-objects-service",
  "version": "1.0.0",
  "description": "API collaborative d'édition de documents",
  "private": true,
  "scripts": {
    "build:shared": "npm --prefix ../shared/user-module run build && npm --prefix ../shared/nest-user-module run build",
    "prebuild": "npm run build:shared",
    "build": "nest build",
    "start": "nest start",
    "prestart:dev": "npm run build:shared",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --coverage"
  },
  "dependencies": {
    "@larpbabylone/nest-user-module": "file:../shared/nest-user-module",
    "@larpbabylone/user-module": "file:../shared/user-module",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.14.1",
    "typeorm": "^0.3.28",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!uuid)"
    ],
    "moduleNameMapper": {
      "^@larpbabylone/nest-user-module$": "<rootDir>/../../shared/nest-user-module/src",
      "^@larpbabylone/user-module$": "<rootDir>/../../shared/user-module/src"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../../coverage/back",
    "testEnvironment": "node"
  }
}
